{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: Configure (Debug)",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Configure CMake project in Debug mode"
        },
        {
            "type": "shell",
            "label": "CMake: Build (Debug)",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["CMake: Configure (Debug)"],
            "detail": "Build Tetris project with CMake (Debug)"
        },
        {
            "type": "shell",
            "label": "CMake: Configure (Release)",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Configure CMake project in Release mode"
        },
        {
            "type": "shell",
            "label": "CMake: Build (Release)",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Release",
                "--",
                "-j",
                "4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "dependsOn": ["CMake: Configure (Release)"],
            "detail": "Build Tetris project with CMake (Release)"
        },
        {
            "type": "shell",
            "label": "CMake: Clean",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Clean build directory"
        },
        {
            "type": "shell",
            "label": "Run Tetris (Debug)",
            "command": "${workspaceFolder}/build/Tetris",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": ["CMake: Build (Debug)"],
            "detail": "Build and run Tetris in Debug mode"
        }
    ],
    "version": "2.0.0"
}